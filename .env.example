CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=exnzehf1
# Tùy chọn: dùng hai dòng dưới để ghi đè API Key/Secret trong CLOUDINARY_URL.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Giám sát cháy bằng webcam máy tính
FIRE_CAMERA_INDEX=0
