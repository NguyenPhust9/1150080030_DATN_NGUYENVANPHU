DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Supabase: copy Connection string > Session pooler; replace project ref, password and host.
# When DATABASE_URL is set, Django uses it instead of the POSTGRES_* values below.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
POSTGRES_DB=ql_phong_cho_thue
POSTGRES_TEST_DB=test_ql_phong_cho_thue
POSTGRES_USER=ql_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
# Tùy chọn: dùng hai dòng dưới để ghi đè API Key/Secret trong CLOUDINARY_URL.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Giám sát cháy bằng webcam máy tính
FIRE_CAMERA_INDEX=0
# UUID của Camera trong Django Admin để gắn cảnh báo webcam vào Indoor Map.
FIRE_CAMERA_ID=
FIRE_MODEL_PATH=runs/fire_detection/dfire_yolo11n_e30/weights/best.pt
# Bội số 32, từ 320 đến 1536; cần kiểm tra lại độ chính xác khi đổi kích thước.
FIRE_IMAGE_SIZE=512
FIRE_CONFIDENCE=0.25
SMOKE_CONFIDENCE=0.55
FIRE_CONFIRM_FRAMES=2
FIRE_ALERT_COOLDOWN_SECONDS=30

# WebRTC ICE servers (JSON array). Configure STUN/TURN for calls across networks.
WEBRTC_ICE_SERVERS=[]

# n8n: Production URL, POST JSON; publish/activate the workflow first.
FIRE_WEBHOOK_URL=
# Optional: configure n8n Header Auth with X-Fire-Webhook-Token and the same value.
FIRE_WEBHOOK_TOKEN=
FIRE_CAMERA_NAME=Webcam 0
FIRE_CAMERA_LOCATION=
